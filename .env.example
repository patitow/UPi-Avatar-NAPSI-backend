# --- Modo desenvolvimento (sem Docker) ---
# Use start_dev.ps1 ou start_local.sh — já define UPI_DEV_MODE=1
UPI_DEV_MODE=1
CHROMA_PERSIST_DIR=./data/chroma_db
DEV_CACHE_PATH=./data/dev_semantic_cache.json

# --- Modo produção / Docker (compose-up) ---
# UPI_DEV_MODE=0
# DATABASE_URL=postgresql+psycopg2://upi_user:upi_password@localhost:5432/upi_db
# REDIS_URL=redis://localhost:6379

OLLAMA_BASE_URL=http://localhost:11434
# Padrão do projeto: llama3.2:3b — no teu .env local podes usar outro (ex.: qwen2.5:7b)
OLLAMA_MODEL=llama3.2:3b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

TTS_PROVIDER=gtts
TTS_OPENAI_VOICE=nova

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
