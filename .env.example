# Copia para .env (o .env não vai para o Git).
#
# ========== Desenvolvimento local (sem Docker) ==========
# Use start_dev.ps1 — já define UPI_DEV_MODE=1
# UPI_DEV_MODE=1
# CHROMA_PERSIST_DIR=./data/chroma_db
# DEV_CACHE_PATH=./data/dev_semantic_cache.json

# ========== Stack Docker (compose-up.ps1) ==========
UPI_DEV_MODE=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Embeddings: auto = OpenAI se OPENAI_API_KEY existir; senão Ollama
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDINGS_PROVIDER=auto
# Ao migrar de Ollama → OpenAI, use nova coleção e reindexe (scripts/rebuild_knowledge.py)
COLLECTION_NAME=upi_knowledge
# none = mais rápido (TTS no navegador); gtts | openai = áudio no servidor
TTS_PROVIDER=none
TTS_OPENAI_VOICE=nova
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://upi.patitow.dev

# Produção: senha simples para fechar o site (ignorada com UPI_DEV_MODE=1)
SITE_ACCESS_PASSWORD=
SITE_AUTH_SECRET=change-me-in-production
UPI_FAST_GREETINGS=1
UPI_LOG_TIMINGS=0

# ========== Produção em casa (compose-prod.ps1 -Ddns) ==========
# Mesmo token Cloudflare serve para mine.patitow.dev e api.upi.patitow.dev
# (desde que tenha Zone → DNS → Edit em patitow.dev).
#
# Token: Cloudflare → My Profile → API Tokens → Create Token
# (template "Edit zone DNS" ou Zone → DNS → Edit na zona patitow.dev).
#
# Depois de preencher: .\compose-prod.ps1 -Ddns
#
# Certificados HTTPS (obrigatório em produção):
#   Cloudflare → SSL/TLS → Origin Server → Create Certificate
#   Guardar em certs/origin.pem e certs/origin-key.pem
#   Cloudflare → SSL/TLS → Overview → Full (strict)
#   Ver certs/README.md

CLOUDFLARE_API_TOKEN=
# FQDN(s) a atualizar; vírgula se forem vários.
DDNS_DOMAINS=api.upi.patitow.dev
