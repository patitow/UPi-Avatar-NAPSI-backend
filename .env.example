# LLM (opcional — sem chave usa Ollama)
OPENAI_API_KEY=

# Ollama (host local ou container via compose-up)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Postgres + pgvector (RAG)
DATABASE_URL=postgresql+psycopg2://upi_user:upi_password@localhost:5432/upi_db

# Cache semântico
REDIS_URL=redis://localhost:6379
SEMANTIC_CACHE_DISTANCE=0.12

# TTS: gtts | openai | none
TTS_PROVIDER=gtts
TTS_OPENAI_VOICE=nova

# CORS (vírgulas ou *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
